{
  "name": "esse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "eval": "node scripts/eval.mjs",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "build:staging": "wrangler deploy --dry-run --env staging --outdir dist-staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy --env=\"\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  }
}
